choice SPECTER_ROOT_VALIDATION_TARGET
    prompt "Application placement target"
    default SPECTER_ROOT_VALIDATION_TARGET_BOOT_A
    help
        Select where idf.py places the application artifact. Root Loader
        runtime selection always uses approval, request, and trial state.

    config SPECTER_ROOT_VALIDATION_TARGET_BOOT_A
        bool "boot_a"

    config SPECTER_ROOT_VALIDATION_TARGET_BOOT_B
        bool "boot_b"

    config SPECTER_ROOT_VALIDATION_TARGET_MAIN
        bool "main"
endchoice
