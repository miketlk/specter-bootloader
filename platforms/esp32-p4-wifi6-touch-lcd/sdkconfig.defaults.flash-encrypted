# Full-partition, release-mode flash encryption. First boot on real hardware is
# irreversible; Phase 2 only compiles this profile.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES256=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# CONFIG_SECURE_FLASH_ENCRYPT_ONLY_IMAGE_LEN_IN_APP_PART is not set

# NVS uses its own XTS encryption. Its keys are protected by the device-local
# flash-encryption key in the encrypted nvs_keys partition.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
