# Development profile: no physical eFuse writes or other irreversible MCU
# configuration. CMake independently rejects these settings if a stale or
# manually edited sdkconfig attempts to enable them.
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT is not set
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
# CONFIG_SECURE_DISABLE_ROM_DL_MODE is not set
# CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE is not set
CONFIG_BOOT_ROM_LOG_ALWAYS_ON=y
# CONFIG_BOOT_ROM_LOG_ALWAYS_OFF is not set
# CONFIG_BOOT_ROM_LOG_ON_GPIO_HIGH is not set
# CONFIG_BOOT_ROM_LOG_ON_GPIO_LOW is not set
# CONFIG_ESP_CRYPTO_FORCE_ECC_CONSTANT_TIME_POINT_MUL is not set
# CONFIG_ESP_ECDSA_ENABLE_P192_CURVE is not set
